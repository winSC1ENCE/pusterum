# ==============================================================================
# Caddyfile – reverse proxy, automatic HTTPS (Let's Encrypt) and edge protection
# Required env (from .env): DOMAIN=www.pusterum.be, ACME_EMAIL=…
# ==============================================================================
{
	email {$ACME_EMAIL}
	order rate_limit before reverse_proxy
}

# Apex domain → canonical www domain (with HSTS on the apex as well)
pusterum.be {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Uploads are capped at 10 MB by the app; reject larger bodies early.
	request_body {
		max_size 12MB
	}

	# Edge rate limits per client IP (the app enforces its own limits as well)
	rate_limit {
		zone admin_login {
			match {
				method POST
				path /admin/login /admin/login/verify
			}
			key {remote_host}
			events 10
			window 1m
		}
		zone contact_form {
			match {
				method POST
				path /contact
			}
			key {remote_host}
			events 5
			window 10m
		}
		zone altcha {
			match {
				path /altcha/challenge
			}
			key {remote_host}
			events 30
			window 1m
		}
	}

	# HSTS here; CSP, COOP/CORP, nosniff etc. are set by the application
	# (presentation/security/security_headers.py). `preload` is deliberately not set yet.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}

	reverse_proxy app:8000

	# Access log without full client IPs (ADR-0006): IPv4 /24, IPv6 /48. Abuse protection uses the
	# app's own logs (fail2ban) and Caddy's rate limits, not this log.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}
}
