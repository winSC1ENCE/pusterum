# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-insecure-secret-key-in-production-min-32-chars
PORT=8000
HOST=0.0.0.0
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]

# Database (PostgreSQL)
POSTGRES_USER=atem_user
POSTGRES_PASSWORD=atem_secure_password
POSTGRES_DB=atem_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://atem_user:atem_secure_password@localhost:5432/atem_db

# Email / Contact Form Notifications
MAIL_ENABLED=false
MAIL_FROM=info@atem-praxis.ch
MAIL_TO=therapeutin@atem-praxis.ch
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Security & Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@atem-praxis.ch
ADMIN_INITIAL_PASSWORD=admin-secure-init-pass-change-me

# Domain Configuration
DOMAIN=atem-praxis.ch
