classDiagram
    %% =========================================================================
    %% DOMAIN LAYER
    %% =========================================================================
    class BaseEntity {
        +UUID id
        +datetime created_at
        +datetime updated_at
    }

    class TherapistProfile {
        +str full_name
        +str title
        +str diploma
        +str tagline
        +str bio
        +str quote
        +str profile_image_url
        +str? booking_external_url
    }

    class Competency {
        +str title
        +str description
        +str icon_name
        +int sort_order
        +bool is_active
    }

    class ServiceOffering {
        +str title
        +str slug
        +str subtitle
        +str description
        +int duration_minutes
        +float price_chf
        +bool is_health_insurance_recognized
        +int sort_order
        +bool is_active
    }

    class PracticeInfo {
        +str name
        +str street
        +str zip_code
        +str city
        +str canton
        +str country
        +str phone
        +str email
        +str directions_info
        +str accessibility_info
        +float? latitude
        +float? longitude
    }

    class ContactMessage {
        +str sender_name
        +str sender_email
        +str? sender_phone
        +str subject
        +str message
        +MessageStatus status
        +str? notes
        +str? ip_address
    }

    class User {
        +str username
        +str email
        +str password_hash
        +UserRole role
        +bool is_active
    }

    class ContentBlock {
        +str key
        +ContentBlockType block_type
        +str section
        +int current_version_number
        +str current_content
        +datetime updated_at
    }

    class ContentBlockVersion {
        +UUID id
        +str block_key
        +int version_number
        +str content
        +UUID? author_id
        +str author_name
        +str? change_summary
        +datetime created_at
    }

    class ThemeConfig {
        +str name
        +ColorPresetKey preset_key
        +ShapeType shape_type
        +str primary_color
        +str secondary_color
        +str accent_color
        +str bg_color
        +str surface_color
        +str text_main_color
        +str font_heading
        +str font_body
    }

    BaseEntity <|-- TherapistProfile
    BaseEntity <|-- Competency
    BaseEntity <|-- ServiceOffering
    BaseEntity <|-- PracticeInfo
    BaseEntity <|-- ContactMessage
    BaseEntity <|-- User
    BaseEntity <|-- ThemeConfig
    ContentBlock *-- ContentBlockVersion : versions

    %% =========================================================================
    %% DOMAIN INTERFACES (ABCs / Ports)
    %% =========================================================================
    class IProfileRepository {
        <<interface>>
        +get_profile()* TherapistProfile
        +save_profile(profile)* TherapistProfile
        +get_competencies(active_only)* list~Competency~
        +get_services(active_only)* list~ServiceOffering~
        +get_service_by_id(service_id)* ServiceOffering?
        +save_service(service)* ServiceOffering
        +delete_service(service_id)* bool
        +get_practice_info()* PracticeInfo?
        +save_practice_info(practice)* PracticeInfo
    }

    class IContactRepository {
        <<interface>>
        +create_message(message)* ContactMessage
        +get_messages(status, limit, offset)* list~ContactMessage~
        +get_message_by_id(message_id)* ContactMessage?
        +update_message(message)* ContactMessage
        +delete_message(message_id)* bool
    }

    class IUserRepository {
        <<interface>>
        +get_by_username(username)* User?
        +get_by_email(email)* User?
        +get_by_id(user_id)* User?
        +create_user(user)* User
        +update_user(user)* User
    }

    class IContentRepository {
        <<interface>>
        +get_block(key)* ContentBlock?
        +get_all_blocks()* dict~str, ContentBlock~
        +save_version(key, content, author_id, author_name, change_summary)* ContentBlockVersion
        +get_version_history(key)* list~ContentBlockVersion~
        +restore_version(key, target_version_number, author_id, author_name)* ContentBlockVersion
    }

    class IThemeRepository {
        <<interface>>
        +get_active_theme()* ThemeConfig
        +save_theme(theme)* ThemeConfig
    }

    class IEmailService {
        <<interface>>
        +send_contact_notification(message)* bool
        +send_contact_confirmation(message)* bool
    }

    class IPasswordHasher {
        <<interface>>
        +hash_password(plain_password)* str
        +verify_password(plain_password, hashed_password)* bool
    }

    %% =========================================================================
    %% INFRASTRUCTURE LAYER (Adapters)
    %% =========================================================================
    class SqlAlchemyProfileRepository {
        -AsyncSession _session
        +get_profile() TherapistProfile
        +save_profile(profile) TherapistProfile
        +get_services() list~ServiceOffering~
    }

    class SqlAlchemyContactRepository {
        -AsyncSession _session
        +create_message(message) ContactMessage
        +get_messages() list~ContactMessage~
    }

    class SqlAlchemyUserRepository {
        -AsyncSession _session
        +get_by_username(username) User?
        +create_user(user) User
    }

    class SqlAlchemyContentRepository {
        -AsyncSession _session
        +get_block(key) ContentBlock?
        +get_all_blocks() dict~str, ContentBlock~
        +save_version(...) ContentBlockVersion
        +get_version_history(key) list~ContentBlockVersion~
        +restore_version(...) ContentBlockVersion
    }

    class SqlAlchemyThemeRepository {
        -AsyncSession _session
        +get_active_theme() ThemeConfig
        +save_theme(theme) ThemeConfig
    }

    class SmtpEmailService {
        -Settings _settings
        +send_contact_notification(message) bool
        +send_contact_confirmation(message) bool
    }

    class MockEmailService {
        +send_contact_notification(message) bool
        +send_contact_confirmation(message) bool
    }

    class Argon2PasswordHasher {
        -PasswordHasher _ph
        +hash_password(plain_password) str
        +verify_password(plain_password, hashed_password) bool
    }

    IProfileRepository <|.. SqlAlchemyProfileRepository
    IContactRepository <|.. SqlAlchemyContactRepository
    IUserRepository <|.. SqlAlchemyUserRepository
    IContentRepository <|.. SqlAlchemyContentRepository
    IThemeRepository <|.. SqlAlchemyThemeRepository
    IEmailService <|.. SmtpEmailService
    IEmailService <|.. MockEmailService
    IPasswordHasher <|.. Argon2PasswordHasher

    %% =========================================================================
    %% APPLICATION LAYER (Services)
    %% =========================================================================
    class ProfileService {
        -IProfileRepository _repository
        +get_public_profile() TherapistProfileDTO
        +update_profile(dto) TherapistProfileDTO
        +create_service(dto) ServiceOfferingDTO
    }

    class ContactService {
        -IContactRepository _repository
        -IEmailService _email_service
        +submit_contact_form(dto, client_ip) ContactMessageResponseDTO
        +list_messages(status) list~ContactMessageResponseDTO~
    }

    class AuthService {
        -IUserRepository _user_repository
        -IPasswordHasher _password_hasher
        +authenticate(dto) UserResponseDTO
    }

    class ContentService {
        -IContentRepository _repository
        +get_content_map() dict~str, ContentBlockResponseDTO~
        +save_block_content(key, content, author_id, author_name) ContentBlockResponseDTO
        +get_block_history(key) list~ContentVersionItemDTO~
        +restore_block_version(key, version_number, author_id, author_name) ContentBlockResponseDTO
    }

    class ThemeService {
        -IThemeRepository _repository
        +get_active_theme() ThemeConfig
        +apply_preset(key) ThemeConfig
        +generate_css_variables(theme) str
    }

    ProfileService --> IProfileRepository : uses
    ContactService --> IContactRepository : uses
    ContactService --> IEmailService : uses
    AuthService --> IUserRepository : uses
    AuthService --> IPasswordHasher : uses
    ContentService --> IContentRepository : uses
    ThemeService --> IThemeRepository : uses

    %% =========================================================================
    %% PRESENTATION LAYER (Controllers)
    %% =========================================================================
    class PublicController {
        +index(profile_service, theme_service, content_service) Template
        +handle_contact_form(request, contact_service, data) Template
        +impressum(profile_service, theme_service, content_service) Template
        +datenschutz(profile_service, theme_service, content_service) Template
    }

    class AdminController {
        +login_page(request, theme_service) Template
        +process_login(request, auth_service, data) Redirect
        +dashboard(request, profile_service, contact_service) Template
        +design_studio(request, theme_service) Template
        +save_content_block(request, content_service, key, data) Template
        +get_content_history(request, content_service, key) Template
        +restore_content_version(request, content_service, key, version) Template
        +list_images(request) list~dict~
        +upload_image(request, data) dict
    }

    PublicController ..> ProfileService : DI
    PublicController ..> ContactService : DI
    PublicController ..> ThemeService : DI
    PublicController ..> ContentService : DI
    AdminController ..> AuthService : DI
    AdminController ..> ProfileService : DI
    AdminController ..> ContactService : DI
    AdminController ..> ThemeService : DI
    AdminController ..> ContentService : DI
