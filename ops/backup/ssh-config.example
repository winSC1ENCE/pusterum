# secrets/backup_ssh/config – SSH-Zugang zum SFTP-Backup-Speicher (nur Schlüssel)
Host backup-target
    HostName backup.example.net
    User backup-user
    # Port gemäss Anbieter (manche SFTP-Speicher nutzen nicht 22)
    Port 22
    IdentityFile /root/.ssh/id_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /root/.ssh/known_hosts
