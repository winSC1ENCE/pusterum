# ==============================================================================
# LOKALE ENTWICKLUNG – kopieren:  cp config/env.development.example .env
# Niemals auf dem Server verwenden (Produktion: config/env.production.example).
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
# Dev-Schlüssel (in Produktion verboten – die App verweigert dort den Start)
SECRET_KEY=dev-only-insecure-secret-key-do-not-use-in-production
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Datenbank (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://atem_user:atem_secure_password@localhost:5432/atem_db

# E-Mail (lokal deaktiviert → MockEmailService loggt nur)
MAIL_ENABLED=false
MAIL_FROM=kontakt@pusterum.be
MAIL_TO=kontakt@pusterum.be

# Lokaler Admin (wird nur in development automatisch angelegt)
# Login = E-Mail-Adresse (keine Benutzernamen; Sammeladressen wie admin@… werden abgelehnt)
ADMIN_EMAIL=entwicklung@pusterum.be
ADMIN_INITIAL_PASSWORD=admin-secure-init-pass-change-me
