# ==============================================================================
# Caddyfile - Reverse Proxy & Automatic SSL Configuration
# ==============================================================================

# Apex-Domain dauerhaft auf die kanonische www-Domain umleiten (.be = Bern)
pusterum.be {
    redir https://www.pusterum.be{uri} permanent
}

# Kanonische Domain: DOMAIN=www.pusterum.be in .env
{$DOMAIN:localhost} {
    encode gzip zstd

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Reverse proxy to Litestar application
    reverse_proxy app:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Logging
    log {
        output stdout
        format console
    }
}
