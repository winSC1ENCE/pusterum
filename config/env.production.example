# ==============================================================================
# PRODUKTION (Hosting) – auf dem Server kopieren:  cp config/env.production.example .env  (dazu db.env, backup.env)
# und ALLE «CHANGE_ME» ersetzen. Die App verweigert den Start mit unsicheren Werten
# (Dev-Secret, DEBUG, Standard-DB-Passwort, Mail ohne TLS, ALLOWED_HOSTS nur localhost).
# Lokale Entwicklung: config/env.development.example
# ==============================================================================

ENVIRONMENT=production
DEBUG=false
# Erzeugen: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=CHANGE_ME
ALLOWED_HOSTS=["www.pusterum.be", "pusterum.be", "localhost"]

# Caddy (kanonische Domain mit www – pusterum.be leitet dorthin um)
DOMAIN=www.pusterum.be
ACME_EMAIL=admin@pusterum.be

# Datenbank (Passwort identisch mit POSTGRES_PASSWORD in db.env)
DATABASE_URL=postgresql+asyncpg://atem_user:CHANGE_ME@db:5432/atem_db

# E-Mail (Kontaktformular) – TLS ist in Produktion Pflicht
MAIL_ENABLED=true
MAIL_FROM=kontakt@pusterum.be
MAIL_TO=kontakt@pusterum.be
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=kontakt@pusterum.be
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=false
SMTP_STARTTLS=true

# Erster Admin: NICHT hier, sondern einmalig im Container anlegen:
#   docker compose -f docker-compose.prod.yml exec app python -m atem.cli create-admin \
#     --username stephanie --email kontakt@pusterum.be
