# restic-Backups auf den SFTP-Backup-Speicher – kopieren nach ./backup.env, chmod 600
# Repository-Pfad: sftp:<backup-host-alias>:<pfad> (Alias aus secrets/backup_ssh/config)
RESTIC_REPOSITORY=sftp:backup-target:/pusterum-restic
# Lang & zufällig – OHNE dieses Passwort sind die Backups nicht wiederherstellbar!
# Zusätzlich offline (z. B. Passwortmanager/ausgedruckt) aufbewahren.
RESTIC_PASSWORD=CHANGE_ME
# Optional: Überwachung (healthchecks.io o. ä.) – meldet ausgebliebene/fehlgeschlagene Backups
HEALTHCHECK_PING_URL=
# Optional: Zeitplan (Container-Zeitzone Europe/Zurich)
BACKUP_CRON=30 2 * * *
CHECK_CRON=15 4 * * 0
