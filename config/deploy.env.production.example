# deploy.env – read by ops/deploy/pusterum-deploy.sh (systemd timer, every 5 min). Copy to
# /opt/pusterum/deploy.env (next to docker-compose.prod.yml, never into git).
# Only the line below is read; the file is not executed.

# Optional: ping URL of a healthcheck service (e.g. healthchecks.io). Every run reports
# «ok» or «/fail» with the message; a missing ping raises an alarm, too (server down, timer stopped).
# Period 5 min, grace 20 min. Empty = no notification.
DEPLOY_PING_URL=
