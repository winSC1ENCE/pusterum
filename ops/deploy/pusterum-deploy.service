# Pull-based deployment (ADR-0005). Install: docs/ops/runbook.md, section 1.13.
[Unit]
Description=PUSTERUM: deploy new commits from the production branch
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/pusterum
ExecStart=/opt/pusterum/ops/deploy/pusterum-deploy.sh
TimeoutStartSec=20min
